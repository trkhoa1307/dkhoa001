    <!-- JS ĐIỀU KHIỂN WEB -->
    <script>
        function showScreen(screenId, downloadLink = null, fromScreenId = 'screen-home') {
            const screens = document.querySelectorAll('.screen');
            screens.forEach(function(screen) {
                screen.classList.remove('active');
            });
            document.getElementById(screenId).classList.add('active');
            window.scrollTo(0, 0);

            if (screenId === 'screen-app-download') {
                if (downloadLink) {
                    document.getElementById('final-download-btn').href = downloadLink;
                }
                const backBtn = document.getElementById('app-download-back-btn');
                backBtn.onclick = function() { showScreen(fromScreenId); };
                
                if (fromScreenId === 'screen-ff') {
                    backBtn.innerHTML = '‹ Quay lại Cửa hàng Mod';
                } else if (fromScreenId === 'screen-mod') {
                    backBtn.innerHTML = '‹ Quay lại Mod File';
                } else if (fromScreenId === 'screen-mod-alok') {
                    backBtn.innerHTML = '‹ Quay lại ALOK';
                } else if (fromScreenId === 'screen-mod-ignis') {
                    backBtn.innerHTML = '‹ Quay lại IGNIS';
                } else if (fromScreenId === 'screen-mod-kapella') {
                    backBtn.innerHTML = '‹ Quay lại KAPELLA';
                }
            }
        }

        function switchModTab(element) {
            const tabs = document.querySelectorAll('.tab-btn');
            tabs.forEach(tab => tab.classList.remove('active'));
            element.classList.add('active');
        }

        function openPaymentPopup(accId) {
            document.getElementById('syntax-display').innerText = accId + ' + HỌ VÀ TÊN';
            document.getElementById('syntax-example').innerText = accId + ' NGUYEN VAN A';
            document.getElementById('payment-modal').classList.add('active');
        }

        function openContactPopup() {
            document.getElementById('contact-modal').classList.add('active');
        }

        function closePopup(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        window.onclick = function(event) {
            let paymentModal = document.getElementById('payment-modal');
            let contactModal = document.getElementById('contact-modal');
            
            if (event.target == paymentModal) {
                paymentModal.classList.remove('active');
            }
            if (event.target == contactModal) {
                contactModal.classList.remove('active');
            }
        }
    </script>

