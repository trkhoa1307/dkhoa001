<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DANG KHOA MOD</title>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Exo+2:wght@600;700;800&display=swap');

        body {
            font-family: 'Be Vietnam Pro', system-ui, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #0a1328; 
            color: #e8eefc; 
        }

        /* ----- NAVBAR ----- */
        .navbar {
            background-color: #050914;
            padding: 12px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #ff7a28; 
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-box {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 12px; 
            cursor: pointer;
        }

        .badge-dk {
            background: linear-gradient(145deg, rgba(47,123,255,0.4), #0b1325);
            border: 1px solid rgba(47,123,255,0.6);
            color: #ffffff;
            font-family: 'Exo 2', sans-serif;
            font-weight: 800;
            font-size: 20px;
            width: 44px;
            height: 44px;
            border-radius: 12px; 
            display: grid;
            place-items: center;
        }

        .logo-title {
            color: #ffffff;
            font-size: 19px;
            font-family: 'Exo 2', sans-serif;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-links a {
            color: #8da0c4;
            text-decoration: none;
            font-family: 'Exo 2', sans-serif;
            font-weight: 700;
            font-size: 14px;
            padding: 5px 0;
            position: relative;
            transition: color 0.3s;
            cursor: pointer;
        }

        .nav-links a.active, .nav-links a:hover {
            color: #ff7a28; 
        }

        .nav-links a.active::after {
            content: '';
            position: absolute;
            bottom: -15px; 
            left: 0;
            width: 100%;
            height: 2px;
            background-color: #ff7a28;
        }

        /* ----- MAIN & LAYOUT ----- */
        main {
            padding: 40px 20px;
            max-width: 900px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .section-title h2 {
            font-family: 'Exo 2', sans-serif;
            font-size: 26px;
            font-weight: 800;
            margin: 0 0 5px 0;
            letter-spacing: 1px;
        }

        .section-title p {
            color: #8da0c4;
            font-size: 15px;
            margin: 0;
        }

        .sub-page-title {
            margin-bottom: 25px;
            text-align: left;
        }

        .sub-page-title h2 {
            font-family: 'Exo 2', sans-serif;
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 5px 0;
            text-transform: uppercase;
        }

        .sub-page-title p {
            color: #8da0c4;
            font-size: 15px;
            margin: 0;
        }

        /* Cơ chế Màn hình */
        .screen {
            display: none; 
            animation: fadeIn 0.4s ease;
        }
        .screen.active {
            display: block; 
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Nút quay lại chung */
        .btn-back {
            display: inline-block;
            background-color: transparent;
            color: #8da0c4;
            border: 1px solid #1f2d4a;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 20px;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-back:hover {
            color: white;
            border-color: #ff7a28;
        }

        /* ----- MÀN HÌNH 1: TRANG CHỦ ----- */
        .game-grid {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap; 
        }

        .game-card {
            background: linear-gradient(160deg, rgba(47,123,255,0.2), #0b1325);
            border: 1px solid rgba(47,123,255,0.5);
            border-radius: 26px;
            padding: 18px 12px 16px;
            width: 230px; 
            text-align: center;
            text-decoration: none; 
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
            cursor: pointer;
        }

        .game-card.ff {
            border-color: rgba(255,122,40,0.8);
            box-shadow: 0 0 15px rgba(255,122,40,0.2);
        }
        .game-card.ff:hover {
            transform: translateY(-2px); 
            border-color: rgba(255,122,40,1);
            box-shadow: 0 0 34px rgba(255,122,40,0.5); 
        }

        .game-card.lq {
            border-color: rgba(47,123,255,0.8);
            box-shadow: 0 0 15px rgba(47,123,255,0.2);
        }
        .game-card.lq:hover {
            transform: translateY(-2px); 
            border-color: rgba(47,123,255,1);
            box-shadow: 0 0 34px rgba(47,123,255,0.5); 
        }

        .game-card img {
            width: 130px; 
            height: 130px;
            border-radius: 22px;
            object-fit: cover;
            margin-bottom: 15px;
            box-shadow: 0 0 18px rgba(0,0,0,0.6);
        }

        .game-card h3 {
            margin: 10px 0 5px 0;
            font-family: 'Exo 2', sans-serif;
            font-size: 16px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .game-card p {
            font-size: 12px;
            color: #8da0c4;
            margin: 0;
        }

        /* ----- MÀN HÌNH 2: FREE FIRE (CỬA HÀNG MOD CŨ) ----- */
        .product-grid {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .product-card {
            background-color: #12224a;
            border: 1px solid #1f2d4a;
            border-radius: 15px;
            width: 280px;
            overflow: hidden; 
            display: flex;
            flex-direction: column;
            transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
        }

        .product-card.orange:hover {
            transform: translateY(-5px);
            border-color: #ff7a28;
            box-shadow: 0 0 20px rgba(255,122,40,0.3);
        }

        .product-card.blue:hover {
            transform: translateY(-5px);
            border-color: #2f7bff;
            box-shadow: 0 0 20px rgba(47,123,255,0.3);
        }

        .product-card img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-bottom: 2px solid #1f2d4a;
        }

        .product-info {
            padding: 20px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-info h3 {
            margin: 0 0 10px 0;
            color: white;
            font-size: 20px;
            font-family: 'Exo 2', sans-serif;
            text-transform: uppercase;
        }

        .product-info .desc {
            color: #8da0c4;
            font-size: 14px;
            margin: 0 0 15px 0;
            line-height: 1.5;
            flex-grow: 1; 
        }

        .product-info .price {
            font-size: 18px;
            font-weight: 800;
            font-family: 'Exo 2', sans-serif;
            margin: 0 0 15px 0;
        }

        .btn-download, .btn-buy {
            color: white;
            text-align: center;
            text-decoration: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
            font-family: 'Exo 2', sans-serif;
            transition: 0.3s;
            display: block;
            cursor: pointer;
        }
        
        .btn-download { background: linear-gradient(90deg, #ff7a28, #e55300); }
        .btn-download:hover { opacity: 0.8; box-shadow: 0 0 10px rgba(255,122,40,0.5); }

        .btn-buy { background: linear-gradient(90deg, #2f7bff, #1c49cc); }
        .btn-buy:hover { opacity: 0.8; box-shadow: 0 0 10px rgba(47,123,255,0.5); }

        /* ----- MÀN HÌNH MOD FILE & NHÂN VẬT ----- */
        .mod-tabs-container {
            margin-bottom: 25px;
            text-align: left;
        }
        
        .mod-tabs-container p {
            color: #8da0c4;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .mod-tabs {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 10px;
            -ms-overflow-style: none;  
            scrollbar-width: none;  
        }
        .mod-tabs::-webkit-scrollbar { display: none; }

        .tab-btn {
            background-color: #0b1325;
            border: 1px solid #1f2d4a;
            color: #8da0c4;
            padding: 12px 25px;
            border-radius: 12px;
            font-weight: bold;
            font-family: 'Exo 2', sans-serif;
            font-size: 14px;
            cursor: pointer;
            white-space: nowrap;
            transition: 0.3s;
        }

        .tab-btn.active {
            background: linear-gradient(180deg, rgba(255,122,40,0.15), rgba(255,122,40,0.05));
            border-color: #ff7a28;
            color: #ffffff;
            box-shadow: 0 0 15px rgba(255,122,40,0.2);
        }

        .tab-btn:hover:not(.active) {
            border-color: #8da0c4;
            color: white;
        }

        .mod-list-content {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .mod-list-item {
            background: linear-gradient(90deg, rgba(255,122,40,0.03), #0b1325);
            border: 1px solid rgba(255,122,40,0.3);
            border-radius: 18px;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            transition: 0.3s;
            cursor: pointer;
        }

        .mod-list-item:hover {
            border-color: #ff7a28;
            box-shadow: 0 5px 20px rgba(255,122,40,0.15);
            transform: translateX(5px);
        }

        .mod-list-left { display: flex; align-items: center; gap: 20px; }
        .mod-list-img { width: 75px; height: 75px; border-radius: 15px; object-fit: cover; border: 1px solid #1f2d4a; }
        .mod-list-info h3 { margin: 0 0 5px 0; color: #ffffff; font-family: 'Exo 2', sans-serif; font-size: 18px; font-weight: 800; text-transform: uppercase; }
        .mod-list-info p { margin: 0; color: #8da0c4; font-size: 14px; }
        .mod-list-arrow { color: #8da0c4; font-size: 20px; font-weight: bold; margin-right: 10px; transition: 0.3s; }
        .mod-list-item:hover .mod-list-arrow { color: #ff7a28; }

        /* ----- MÀN HÌNH 5: TRANG TẢI APP IOS ----- */
        .ios-title-section { text-align: center; margin-bottom: 30px; }
        .ios-title-section h2 { font-family: 'Exo 2', sans-serif; font-size: 36px; font-weight: 800; margin: 0 0 5px 0; color: #ffffff; }
        .ios-title-section p { color: #8da0c4; font-size: 16px; margin: 0; }
        
        .tool-grid { display: flex; justify-content: center; gap: 25px; flex-wrap: wrap; }
        .tool-card { background: linear-gradient(180deg, rgba(255, 230, 210, 0.1), rgba(10, 19, 40, 1)); border: 1px solid rgba(255, 122, 40, 0.4); border-radius: 20px; padding: 30px 20px; width: 200px; text-align: center; text-decoration: none; display: flex; flex-direction: column; align-items: center; transition: 0.3s; cursor: pointer; box-shadow: 0 10px 30px rgba(255, 122, 40, 0.05); }
        .tool-card:hover { transform: translateY(-5px); border-color: rgba(255, 122, 40, 0.9); box-shadow: 0 15px 40px rgba(255, 122, 40, 0.2); }
        .tool-icon { width: 90px; height: 90px; border-radius: 22px; object-fit: cover; margin-bottom: 20px; box-shadow: 0 8px 15px rgba(0,0,0,0.4); }
        .tool-title { font-family: 'Exo 2', sans-serif; font-size: 20px; font-weight: 800; color: #ffffff; margin: 0 0 5px 0; letter-spacing: 0.5px; }
        .tool-subtitle { font-size: 14px; color: #8da0c4; margin: 0; }


        /* ----- POPUP (MODAL) CHUNG ----- */
        .modal {
            display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.85); justify-content: center; align-items: center; animation: fadeIn 0.3s ease;
        }
        .modal.active { display: flex; }
        .modal-content { background-color: #0b1325; border: 2px solid #2f7bff; border-radius: 15px; padding: 25px; width: 90%; max-width: 400px; text-align: center; position: relative; box-shadow: 0 0 25px rgba(47,123,255,0.3); }
        .close-btn { position: absolute; top: 10px; right: 15px; color: #8da0c4; font-size: 28px; font-weight: bold; cursor: pointer; transition: 0.3s; }
        .close-btn:hover { color: #ff7a28; }
        .modal-content h3 { color: #ffffff; font-family: 'Exo 2', sans-serif; font-size: 22px; margin-top: 5px; margin-bottom: 20px; }
        
        .qr-image { width: 180px; height: 180px; border-radius: 10px; border: 3px solid #2f7bff; padding: 5px; background: white; margin-bottom: 20px; }
        .transfer-box { background-color: #12224a; border: 1px dashed #2f7bff; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        .transfer-box p { margin: 0 0 8px 0; font-size: 14px; color: #8da0c4; }
        .transfer-box h4 { margin: 0; color: #ff7a28; font-size: 18px; font-family: 'Exo 2', sans-serif; }
        .transfer-box .note { font-size: 12px; color: #a0a0a0; margin-top: 5px; font-style: italic; }

        .contact-btn { color: white; text-decoration: none; padding: 12px 15px; border-radius: 8px; font-weight: bold; font-family: 'Exo 2', sans-serif; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 15px; font-size: 15px; }
        .contact-btn img { width: 28px; height: 28px; border-radius: 5px; object-fit: cover; }
        .zalo-btn { background: linear-gradient(90deg, #0068ff, #004cbb); }
        .zalo-btn:hover { box-shadow: 0 0 15px rgba(0,104,255,0.6); }
        .fb-btn { background: linear-gradient(90deg, #1877f2, #145dbf); }
        .fb-btn:hover { box-shadow: 0 0 15px rgba(24,119,242,0.6); }

        footer { text-align: center; padding: 20px; background-color: transparent; color: #8da0c4; margin-top: 50px; font-size: 14px; }

        /* ----- NÚT ZALO TRÔI NỔI ----- */
        .zalo-floating { position: fixed; bottom: 20px; right: 20px; width: 60px; height: 60px; background-color: #0068ff; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 4px 15px rgba(0, 104, 255, 0.5); z-index: 1500; text-decoration: none; animation: ring 2s infinite ease-in-out; transition: transform 0.3s; overflow: hidden; }
        .zalo-floating:hover { transform: scale(1.1); }
        .zalo-floating img { width: 100%; height: 100%; object-fit: cover; }

        @keyframes ring { 0% { transform: rotate(0); } 10% { transform: rotate(15deg); } 20% { transform: rotate(-15deg); } 30% { transform: rotate(10deg); } 40% { transform: rotate(-10deg); } 50% { transform: rotate(5deg); } 60% { transform: rotate(-5deg); } 70% { transform: rotate(0); } 100% { transform: rotate(0); } }
    </style>
</head>
